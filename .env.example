# ─── Database ──────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension
# Local install: postgresql + CREATE EXTENSION vector
# Hosted: Neon or Supabase free tier (supports pgvector + RLS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securerag

# ─── LLM (Gemini via OpenAI-compatible endpoint) ──────────────────────
# Get key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# OpenAI-compatible base URL for Gemini 2.0 Flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# ─── Auth ──────────────────────────────────────────────────────────────
# JWT signing secret (use a long random string in production)
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── OCR ───────────────────────────────────────────────────────────────
# Windows: set path to tesseract.exe (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
# macOS: brew install tesseract (path usually auto-detected)
# Linux: apt install tesseract-ocr (path usually auto-detected)
TESSERACT_CMD=

# ─── Embedding model ───────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
